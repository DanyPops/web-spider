{
	"name": "@danypops/web-spider",
	"version": "0.19.0",
	"license": "MIT",
	"author": "Daniel Popsuevich",
	"homepage": "https://github.com/DanyPops/web-spider/tree/main/packages/web-spider#readme",
	"keywords": [
		"web-scraping",
		"readability",
		"crawler",
		"web-fetch",
		"ai-agent",
		"llm-tools",
		"rag",
		"markdown",
		"pdf-extraction",
		"headless-browser"
	],
	"files": [
		"dist",
		"package.json"
	],
	"description": "AI-agent-friendly web spider: structured output, RAG-ready chunks, graph-traversable links",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./throttle": {
			"types": "./dist/fetch/throttle.d.ts",
			"import": "./dist/fetch/throttle.js",
			"default": "./dist/fetch/throttle.js"
		},
		"./robots": {
			"types": "./dist/fetch/robots.d.ts",
			"import": "./dist/fetch/robots.js",
			"default": "./dist/fetch/robots.js"
		},
		"./web-search": {
			"types": "./dist/web-search/index.d.ts",
			"import": "./dist/web-search/index.js",
			"default": "./dist/web-search/index.js"
		},
		"./sources": {
			"types": "./dist/sources/index.d.ts",
			"import": "./dist/sources/index.js",
			"default": "./dist/sources/index.js"
		},
		"./pdf": {
			"types": "./dist/fetch/pdf-extractor.d.ts",
			"import": "./dist/fetch/pdf-extractor.js",
			"default": "./dist/fetch/pdf-extractor.js"
		},
		"./ocr": {
			"types": "./dist/fetch/pdf-ocr.d.ts",
			"import": "./dist/fetch/pdf-ocr.js",
			"default": "./dist/fetch/pdf-ocr.js"
		},
		"./scribe": {
			"types": "./dist/scribe-bridge.d.ts",
			"import": "./dist/scribe-bridge.js",
			"default": "./dist/scribe-bridge.js"
		}
	},
	"sideEffects": ["./dist/web-search/registry.js", "./dist/sources/registry.js"],
	"scripts": {
		"build": "tsc",
		"test": "vitest --run",
		"check": "tsc --noEmit && tsc -p tsconfig.test.json"
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"linkedom": "^0.18.12",
		"minisearch": "^7.2.0",
		"turndown": "^7.2.4",
		"unpdf": "^1.8.0"
	},
	"devDependencies": {
		"@types/node": "^22.19.19",
		"@types/turndown": "^5.0.6",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"optionalDependencies": {
		"@napi-rs/canvas": "^1.0.5",
		"@tesseract.js-data/eng": "^1.0.0",
		"playwright-core": "^1.60.0",
		"playwright-extra": "^4.3.6",
		"puppeteer-extra-plugin-stealth": "^2.11.2",
		"tesseract.js": "^7.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/web-spider.git",
		"directory": "packages/web-spider"
	}
}
