{
	"name": "@danypops/web-spider-daemon",
	"version": "0.23.1",
	"license": "MIT",
	"author": "Daniel Popsuevich",
	"homepage": "https://github.com/DanyPops/web-spider/tree/main/packages/web-spider-daemon#readme",
	"keywords": [
		"daemon",
		"bun",
		"sqlite",
		"web-scraping",
		"web-fetch",
		"crawler",
		"ai-agent",
		"cli"
	],
	"description": "Supervised Bun daemon for @danypops/web-spider: authenticated loopback fetch/crawl/search/cache operations",
	"type": "module",
	"exports": {
		"./client": {
			"types": "./dist/facade/client.d.ts",
			"import": "./dist/facade/client.js",
			"default": "./dist/facade/client.js"
		},
		"./state": {
			"types": "./dist/facade/state.d.ts",
			"import": "./dist/facade/state.js",
			"default": "./dist/facade/state.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"dist/facade",
		"package.json"
	],
	"bin": {
		"web-spider": "src/cli.ts"
	},
	"scripts": {
		"build:facade": "bun build src/client.ts src/state.ts --outdir dist/facade --target=node --format=esm",
		"test": "bun test",
		"cli": "bun src/cli.ts",
		"serve": "bun src/cli.ts serve",
		"service:install": "bun src/cli.ts service install",
		"check": "bun x tsc --noEmit"
	},
	"dependencies": {
		"@danypops/vehicle-core": "^0.14.0",
		"@danypops/vehicle-server": "^0.22.0",
		"@danypops/vehicle-client": "^0.7.1",
		"@danypops/enigma-client": "^0.6.1",
		"@danypops/web-spider": "^0.18.0"
	},
	"optionalDependencies": {
		"playwright-core": "^1.60.0"
	},
	"devDependencies": {
		"@danypops/pi-process-harness": "^0.1.0",
		"@types/node": "^22.19.19",
		"bun-types": "latest",
		"typescript": "^5.9.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/web-spider.git",
		"directory": "packages/web-spider-daemon"
	}
}
