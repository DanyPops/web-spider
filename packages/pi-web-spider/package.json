{
	"name": "@danypops/pi-web-spider",
	"version": "0.19.0",
	"license": "MIT",
	"description": "Pi extension for web_fetch, web_search, and live browser sessions: 7 search providers (Brave, Brave LLM Context, Tavily, Exa, Serper, SerpApi, You.com) with automatic fallback, robots.txt-respecting crawl, GitHub/Wikipedia/llms.txt-aware fetching, and a disk-backed page cache, all behind a supervised daemon",
	"keywords": [
		"pi-package",
		"web-search",
		"web-scraping",
		"web-fetch",
		"crawler",
		"browser-automation",
		"playwright",
		"brave",
		"tavily",
		"exa"
	],
	"type": "module",
	"main": "./src/index.ts",
	"files": [
		"src"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"dependencies": {
		"@danypops/vehicle-client": "^0.5.1",
		"@danypops/vehicle-client-pi": "^0.15.2",
		"@danypops/vehicle-core": "^0.12.3",
		"@danypops/web-spider": "^0.14.0",
		"@danypops/web-spider-daemon": "^0.18.2",
		"malevich-tui-components": "^0.19.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"scripts": {
		"test": "vitest --run",
		"lint": "biome lint src/",
		"check": "npm run lint && tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@danypops/pi-extension-harness": "^0.4.0",
		"@earendil-works/pi-coding-agent": "^0.80.10",
		"@earendil-works/pi-tui": "^0.80.10",
		"@types/node": "^22.19.19",
		"jiti": "^2.0.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/web-spider.git",
		"directory": "packages/pi-web-spider"
	}
}
